        function setAnonymousUser() {
            userState.isLoggedIn = false;
            userState.name = 'Anonymous user';
            userState.email = '';
            userState.activeTab = 'profile';
            userState.error = '';
            userState.isSubmitting = false;
            userState.isStartingTopUp = false;
            userState.billingNotice = '';
            userState.passwordRulesAttempted = false;
            userState.authForm = { displayName: '', email: '', password: '', region: window.__REGION__ || 'us' };
            userState.tilesOwned = 0;
            userState.visitors = 0;
            userState.netWorth = 0;
            userState.walletBalanceTtk = 0;
