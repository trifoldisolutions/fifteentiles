        function setAuthenticatedUser(user) {
            userState.isLoggedIn = true;
            userState.name = user?.name || user?.email || 'Account';
            userState.email = user?.email || '';
            userState.activeTab = userTabs.some((tab) => tab.id === userState.activeTab) ? userState.activeTab : 'profile';
            userState.error = '';
            userState.isSubmitting = false;
            userState.isStartingTopUp = false;
            userState.passwordRulesAttempted = false;
            userState.authForm = { displayName: '', email: '', password: '', region: window.__REGION__ || 'us' };
            userState.tilesOwned = Number.isFinite(Number(user?.tilesOwned)) ? Number(user.tilesOwned) : 0;
            userState.visitors = Number.isFinite(Number(user?.visitors)) ? Number(user.visitors) : 0;
            userState.netWorth = Number.isFinite(Number(user?.netWorth)) ? Number(user.netWorth) : 0;
            userState.walletBalanceTtk = normalizeWalletBalanceTtk(user);
            userState.topUpTtkAmount = userState.topUpTtkAmount || config.minTopUpTtk.toFixed(2);
            updateUserProfileButton();
