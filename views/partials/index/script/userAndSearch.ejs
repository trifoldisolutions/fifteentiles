                        <path d="M0 0h24v24H0z" fill="none" />
                        <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 6L6 18M6 6l12 12" />
                    </svg>
                `;

            return `
                <div class="flex items-center gap-2 rounded-md border px-3 py-2 text-[0.72rem] font-medium ${stateClass}">
                    ${iconMarkup}
                    <span>${escapeHtml(label)}</span>
                </div>
            `;
        }

        function renderPasswordRequirements() {
            const rules = getPasswordRuleStatus(userState.authForm.password);
            const showErrors = userState.passwordRulesAttempted;

            return `
                <div id="passwordRequirements" class="grid grid-cols-1 gap-2 sm:grid-cols-2">
                    ${renderPasswordRequirement('3 uppercase letters', rules.uppercases, showErrors)}
                    ${renderPasswordRequirement('3 lowercase letters', rules.lowercases, showErrors)}
                    ${renderPasswordRequirement('3 digits', rules.digits, showErrors)}
                    ${renderPasswordRequirement('3 special characters', rules.specials, showErrors)}
                </div>
            `;
        }

        function refreshPasswordRequirements() {
            const requirements = document.getElementById('passwordRequirements');
            if (requirements) {
                requirements.outerHTML = renderPasswordRequirements();
