        function scheduleToastHide(delayMs = toastState.durationMs) {
            if (!Number.isFinite(delayMs) || delayMs <= 0) {
                clearToastHideTimer();
                toastState.remainingMs = 0;
                toastState.startedAt = 0;
                return;
            }

            clearToastHideTimer();
            toastState.remainingMs = delayMs;
            toastState.startedAt = Date.now();

            toastState.hideTimer = window.setTimeout(() => {
                hideToast();
            }, delayMs);
        }

        function pauseToastHide() {
            if (!toastState.isVisible || toastState.hideTimer === null) {
                return;
            }

            const elapsedMs = Date.now() - toastState.startedAt;
            toastState.remainingMs = Math.max(0, toastState.remainingMs - elapsedMs);
            clearToastHideTimer();
        }

        function resumeToastHide() {
            if (!toastState.isVisible || toastState.isHovered) {
                return;
            }

            if (!Number.isFinite(toastState.durationMs) || toastState.durationMs <= 0) {
                return;
            }

            scheduleToastHide(Math.max(toastState.remainingMs, 0));
        }

        function showToast(message, options = {}) {
            const { label = 'Notification', variant = null, tone = null, durationMs = 9000 } = options;
            const resolvedVariant = variant || tone || 'info';

            toastState.durationMs = durationMs;
            toastState.isVisible = true;
            toastState.isHovered = false;
            toastState.remainingMs = Number.isFinite(durationMs) && durationMs > 0 ? durationMs : 0;

            applyToastVariant(resolvedVariant);
            appToastLabel.textContent = label;
            appToastMessage.textContent = message;

            appToast.classList.remove('hidden', '-translate-y-6', 'opacity-0');
            appToast.classList.add('translate-y-0', 'opacity-100');

            scheduleToastHide(durationMs);
        }

        function hideToast() {
            clearToastHideTimer();
            toastState.isVisible = false;
            toastState.isHovered = false;
            toastState.remainingMs = 0;
            toastState.startedAt = 0;

            appToast.classList.remove('translate-y-0', 'opacity-100');
            appToast.classList.add('-translate-y-6', 'opacity-0');

            window.setTimeout(() => {
                if (!toastState.isVisible) {
                    appToast.classList.add('hidden');
                }
            }, 300);
        }

        function normalizeWalletBalanceTtk(user) {
            const directTtkBalance = Number(user?.walletBalanceTtk);
            if (Number.isFinite(directTtkBalance)) {
                return directTtkBalance;
            }

            const minorTtkBalance = Number(user?.walletBalanceTtkMinor);
            if (Number.isFinite(minorTtkBalance)) {
                return minorTtkBalance / 100;
            }

            return 0;
        }

