        async function applyTopUpReturnState() {
            const currentUrl = new URL(window.location.href);
            const topupStatus = currentUrl.searchParams.get('topup');

            if (!topupStatus) {
                return;
            }

            currentUrl.searchParams.delete('topup');
            window.history.replaceState({}, '', `${currentUrl.pathname}${currentUrl.search}${currentUrl.hash}`);

            if (!userState.isLoggedIn) {
                return;
            }

            userState.billingNotice = '';

            if (topupStatus === 'success') {
                try {
                    const response = await fetch('/api/billing/reconcile', {
                        method: 'POST',
                    });
                    const result = await response.json().catch(() => ({}));

                    if (!response.ok) {
                        throw new Error(result.error || 'Unable to sync completed payment.');
                    }

                    if (result.user) {
                        setAuthenticatedUser(result.user);
                    } else {
                        await syncUserSession();
                    }
                    userState.activeTab = 'finances';
                    showToast('Payment received.', {
                        label: 'Payment',
                        variant: 'success',
                    });
                } catch (error) {
                    await syncUserSession();
                    showToast(error.message || 'Unable to sync completed payment.', {
                        label: 'Payment',
                        variant: 'error',
                    });
                }
                return;
            }

            showToast('Checkout was cancelled before any wallet balance was added.', {
                label: 'Payment',
                variant: 'warning',
            });
        }

        function setAuthMode(mode) {
            userState.authMode = mode === 'register' ? 'register' : 'login';
            userState.error = '';
            userState.activeTab = 'profile';
            userState.passwordRulesAttempted = false;
            userState.authForm.password = '';
            renderUserProfilePanel();
        }

