            const tileRatePrimary = userState.showInverseTileRate
                ? formatTileCountValue(1 / config.defaultTileUsdValue)
                : formatUsdValue(config.defaultTileUsdValue);
            const tileRateSecondary = userState.showInverseTileRate
                ? 'for 1 dollar'
                : 'for 1 tile';
            const ttkRatePrimary = userState.showInverseTtkRate
                ? formatTtkValue(1 / config.ttkUsdRate)
                : formatUsdValue(config.ttkUsdRate);
            const ttkRateSecondary = userState.showInverseTtkRate
                ? 'for 1 dollar'
                : '1 TTK';
            const walletBalanceTtk = formatTtkValue(userState.walletBalanceTtk);
            const holdingsTtk = formatTtkValue(estimatedHoldingsTtk);
            const topUpSummary = getTopUpAmountSummary();
            const topUpInputMin = userState.topUpInputCurrency === 'usd'
                ? config.minTopUpUsd.toFixed(2)
                : config.minTopUpTtk.toFixed(2);
            const topUpInputMax = userState.topUpInputCurrency === 'usd'
                ? config.maxTopUpUsd.toFixed(2)
                : config.maxTopUpTtk.toFixed(2);
            const topUpCurrencyLabel = userState.topUpInputCurrency.toUpperCase();
            const topUpConversionHint = topUpSummary.displayAmount !== null
                ? userState.topUpInputCurrency === 'usd'
                    ? `${formatUsdValue(topUpSummary.displayAmount)} = ${formatTtkValue(topUpSummary.amount)}`
                    : `${formatTtkValue(topUpSummary.displayAmount)} = ${formatUsdValue(topUpSummary.usdValue)}`
                : '';
            const topUpValidationMarkup = topUpSummary.error
                ? `<p class="text-step--1 text-sunglo-600">${escapeHtml(topUpSummary.error)}</p>`
                : '';
            const billingNoticeMarkup = userState.billingNotice
                ? `
                    <p class="rounded-md border border-breaker-bay-200 bg-breaker-bay-50 px-3 py-2 text-step--1 text-breaker-bay-700">${escapeHtml(userState.billingNotice)}</p>
                `
                : '';
            const topUpLoadingIcon = `
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M0 0h24v24H0z" fill="none" />
                    <circle cx="4" cy="12" r="3" fill="currentColor">
                        <animate id="SVG7x14Dcom" fill="freeze" attributeName="opacity" begin="0;SVGqSjG0dUp.end-0.25s" dur="0.75s" values="1;.2" />
