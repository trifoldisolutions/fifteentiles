        function getPasswordRuleStatus(password = '') {
            const value = typeof password === 'string' ? password : '';
            const uppercaseCount = (value.match(/[A-Z]/g) || []).length;
            const lowercaseCount = (value.match(/[a-z]/g) || []).length;
            const digitCount = (value.match(/\d/g) || []).length;
            const specialCount = (value.match(/[^A-Za-z0-9]/g) || []).length;

            return {
                minLength: value.length >= 12,
                uppercases: uppercaseCount >= 3,
                lowercases: lowercaseCount >= 3,
                digits: digitCount >= 3,
                specials: specialCount >= 3,
            };
        }

        function isSignupPasswordValid(password = '') {
            return Object.values(getPasswordRuleStatus(password)).every(Boolean);
        }

        function renderPasswordRequirement(label, isMet, showErrors) {
            const stateClass = isMet
                ? 'border-breaker-bay-200 bg-breaker-bay-50 text-breaker-bay-700'
                : showErrors
                    ? 'border-sunglo-200 bg-sunglo-50 text-sunglo-700'
                    : 'border-iron-200 bg-iron-50 text-woodsmoke-400';
            const iconMarkup = isMet
                ? `
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M0 0h24v24H0z" fill="none" />
