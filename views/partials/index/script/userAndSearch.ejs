        async function submitAuthForm(formData) {
            userState.authForm.displayName = String(formData.get('displayName') || '');
            userState.authForm.email = String(formData.get('email') || '');
            userState.authForm.password = String(formData.get('password') || '');
            if (formData.get('region')) {
                userState.authForm.region = String(formData.get('region'));
            }
            userState.error = '';

            if (userState.authMode === 'register' && !isSignupPasswordValid(userState.authForm.password)) {
                userState.passwordRulesAttempted = true;
                userState.error = 'Please satisfy every password requirement before creating your account.';
                renderUserProfilePanel();
                return;
            }

            userState.passwordRulesAttempted = false;
            userState.isSubmitting = true;
            renderUserProfilePanel();

            const endpoint = userState.authMode === 'register' ? '/api/auth/register' : '/api/auth/login';
            const payload = {
                email: userState.authForm.email,
                password: userState.authForm.password,
            };

            if (userState.authMode === 'register') {
                payload.displayName = userState.authForm.displayName;
                payload.region = userState.authForm.region || window.__REGION__ || 'us';
            }

            try {
                const response = await fetch(endpoint, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify(payload),
                });

                const result = await response.json().catch(() => ({}));
                if (!response.ok) {
                    throw new Error(result.error || 'Authentication failed.');
                }

                setAuthenticatedUser(result.user || {});
                closeUserProfilePanel();
                await loadMaps();
            } catch (error) {
                userState.isSubmitting = false;
                userState.error = error.message || 'Authentication failed.';
                userState.passwordRulesAttempted = userState.authMode === 'register';
                renderUserProfilePanel();
            }
        }

        async function logoutUser() {
            try {
                const response = await fetch('/api/auth/logout', {
                    method: 'POST',
                });

                const result = await response.json().catch(() => ({}));
                if (!response.ok) {
                    throw new Error(result.error || 'Unable to sign out.');
                }

                setAnonymousUser();
                closeUserProfilePanel();
                await loadMaps();
            } catch (error) {
                userState.error = error.message || 'Unable to sign out.';
                renderUserProfilePanel();
            }
        }

        async function startTopUpCheckout() {
            if (!userState.isLoggedIn || userState.isStartingTopUp) {
                return;
            }

            const topUpSummary = getTopUpAmountSummary();
            if (topUpSummary.error || topUpSummary.amount === null) {
                userState.billingNotice = topUpSummary.error || 'Enter a valid TTK amount.';
                renderUserProfilePanel();
                return;
            }

            userState.error = '';
            userState.billingNotice = '';
            userState.isStartingTopUp = true;
            renderUserProfilePanel();

            try {
                const response = await fetch('/api/billing/top-up-session', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        ttkAmount: topUpSummary.amount,
                    }),
                });

                const result = await response.json().catch(() => ({}));
                if (!response.ok) {
                    throw new Error(result.error || 'Unable to start checkout.');
                }

                if (!result.url) {
                    throw new Error('Stripe checkout URL was missing.');
                }

                window.location.href = result.url;
            } catch (error) {
                userState.isStartingTopUp = false;
                userState.billingNotice = error.message || 'Unable to start checkout.';
                renderUserProfilePanel();
            }
        }

        async function recordMapVisit(mapId) {
            try {
                await fetch('/api/session/map-visit', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ mapId }),
                });
            } catch (error) {
                console.error('Unable to persist last visited map', error);
            }
        }

        function getInitialRangeDeepLinkState() {
            const params = new URLSearchParams(window.location.search || '');
            const mapId = String(params.get('map') || '').trim();
            const rangeText = String(params.get('range') || '').trim();
            const coordinates = parseRangeCoordinateString(rangeText);

            if (!mapId || !coordinates) {
                return null;
            }

            return { mapId, coordinates };
        }

        function findClaimByCoordinates(ranges, coordinates) {
            const target = `${coordinates.a}.${coordinates.b}.${coordinates.c}`;
            for (const range of (ranges || [])) {
                const existing = range?.coordinates || getRangeCoordinatesFromBounds(range?.bounds);
                if (!existing) {
                    continue;
                }
                const current = `${existing.a}.${existing.b}.${existing.c}`;
                if (current === target) {
                    return range;
                }
            }
            return null;
        }

        function tryApplyInitialRangeDeepLink() {
            const deepLink = getInitialRangeDeepLinkState();
            if (!deepLink || !maps.length) {
                return false;
            }

            const mapIndex = maps.findIndex((map) => String(map?.id || '') === deepLink.mapId);
            if (mapIndex < 0) {
                return false;
            }

            setActiveMap(mapIndex);
            const activeMap = maps[activeMapIndex];
            const targetClaim = findClaimByCoordinates(activeMap?.claimedRanges, deepLink.coordinates);
            if (!targetClaim) {
                return true;
            }

            selectedClaimedRangeId = targetClaim.id;
            claimSelectionState.viewingClaimId = targetClaim.id;
            claimSelectionState.modalPosition = null;
            centerCameraForClaimModalRight(targetClaim.bounds, 0, {
                zoom: 2.5,
                modalWidthPx: 380,
                modalSafeMarginPx: 12,
                tileGapTiles: 1,
            });
            scheduleRender();
            return true;
        }

        function setActiveMap(index) {
            activeMapIndex = index;
            cancelCameraAnimation();
            camera = { ...maps[index].camera };
            hydrateMapClaimedRanges(maps[index]);
            setActiveClaimedRangesFromMap();
            clearTileSelection();
            renderActiveMapDetails();
            renderMapMenu();
            closeMapMenu();
            scheduleRender();
            recordMapVisit(maps[index].id);
        }

        async function loadMaps() {
            try {
                const region = window.__REGION__ || 'us';
                const response = await fetch(`/api/maps?region=${encodeURIComponent(region)}`);
                if (!response.ok) {
                    throw new Error(`Failed to load maps: ${response.status}`);
                }

                const payload = await response.json();
                maps = Array.isArray(payload) ? payload : (payload.maps || []);
                maps.forEach(hydrateMapClaimedRanges);
                mapRanking = Array.isArray(payload) ? mapRanking : (payload.ranking || mapRanking);

                if (!maps.length) {
                    activeMapLabel.textContent = 'No maps found';
                    activeMapIntent.textContent = 'Create a map to get started';
                    return;
                }

                renderMapMenu();
                if (tryApplyInitialRangeDeepLink()) {
                    return;
                }
                setActiveMap(0);
            } catch (error) {
                activeMapLabel.textContent = 'Unable to load maps';
                activeMapIntent.textContent = 'Please try refreshing the page';
                console.error(error);
            }
        }

