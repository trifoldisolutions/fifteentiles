        function renderRegionTag(isActive) {
            const code = (window.__REGION__ || 'us').toUpperCase();
            const color = isActive ? 'text-woodsmoke-300' : 'text-woodsmoke-400';
            return `<span class="ml-1.5 align-middle text-[10px] font-bold tracking-widest ${color}">${code}</span>`;
        }

        function renderMapMenu() {
            mapMenu.innerHTML = '';

            maps.forEach((map, index) => {
                const isActive = index === activeMapIndex;
                const item = document.createElement('button');
                item.type = 'button';
                item.setAttribute('role', 'option');
                item.setAttribute('aria-selected', String(isActive));
                item.className = [
                    'flex w-full items-center justify-between rounded-md px-3 py-2 text-left text-step-0 transition',
                    isActive
                        ? 'bg-breaker-bay-700 text-woodsmoke-50'
                        : 'text-woodsmoke-700 hover:bg-iron-100',
                ].join(' ');

                item.innerHTML = `
                    <span>
                        <span class="block font-medium">${map.name}${renderRegionTag(isActive)}</span>
                        <span class="mt-0.5 block text-step--1 ${isActive ? 'text-woodsmoke-300' : 'text-woodsmoke-400'}">
                            ${map.intent}
                        </span>
                    </span>
                    <span class="h-2.5 w-2.5 rounded-full" style="background:${map.accent}"></span>
                `;

                item.addEventListener('click', () => {
                    setActiveMap(index);
                });

                mapMenu.appendChild(item);
            });
        }

        function renderActiveMapDetails() {
            const activeMap = maps[activeMapIndex];
            if (!activeMap) {
                return;
            }

            activeMapLabel.innerHTML = escapeHtml(activeMap.name) + renderRegionTag(false);
            activeMapIntent.textContent = activeMap.intent;

            const mapClaimedRanges = Array.isArray(activeMap.claimedRanges) ? activeMap.claimedRanges : [];
            const auctionRanges = mapClaimedRanges.filter((range) => range?.status === 'auction');

            const auctionItemsMarkup = auctionRanges.length
                ? auctionRanges.map((range) => {
                    const rangeTitle = escapeHtml(range?.title || range?.name || `Range ${range?.id || ''}`.trim());
                    const bounds = range?.bounds || {};
                    const hasBounds = Number.isFinite(bounds.minCol)
                        && Number.isFinite(bounds.maxCol)
                        && Number.isFinite(bounds.minRow)
                        && Number.isFinite(bounds.maxRow);
                    const boundsLabel = hasBounds
                        ? `X ${bounds.minCol} to ${bounds.maxCol}, Y ${bounds.minRow} to ${bounds.maxRow}`
                        : 'Bounds unavailable';
                    return `
                        <li class="px-1 py-1">
                            <p class="truncate text-step-0 font-semibold text-woodsmoke-900">${rangeTitle}</p>
                            <p class="mt-1 text-step--1 text-woodsmoke-600">${escapeHtml(boundsLabel)}</p>
                        </li>
                    `;
                }).join('')
                : `
                    <li class="px-1 py-1 text-step--1 text-woodsmoke-500">
                        No ranges are currently in auction on this map.
                    </li>
                `;

            mapInfoPanel.innerHTML = `
                <div class="flex h-full flex-col overflow-y-auto p-3">
                    <div class="px-1 py-1">
                        <div class="flex items-baseline justify-between gap-2">
                            <p class="text-step--1 font-semibold uppercase tracking-[0.08em] text-woodsmoke-500">In Auction</p>
                            <p class="text-step--1 font-semibold text-confetti-700">${auctionRanges.length}</p>
                        </div>
                        <ul class="mt-2 space-y-2">${auctionItemsMarkup}</ul>
                    </div>
                </div>
            `;
        }

        function escapeHtml(value) {
            return String(value)
                .replaceAll('&', '&amp;')
                .replaceAll('<', '&lt;')
                .replaceAll('>', '&gt;')
                .replaceAll('"', '&quot;')
                .replaceAll("'", '&#39;');
        }

        function clearToastHideTimer() {
            if (toastState.hideTimer !== null) {
                window.clearTimeout(toastState.hideTimer);
                toastState.hideTimer = null;
