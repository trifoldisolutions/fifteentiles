        function wireUserProfileModalActions() {
            const closeButton = document.getElementById('closeUserProfileModalButton');
            if (closeButton) {
                closeButton.addEventListener('click', () => {
                    closeUserProfilePanel();
                });
            }

            const toggleAuthModeButton = document.getElementById('toggleAuthModeButton');
            if (toggleAuthModeButton) {
                toggleAuthModeButton.addEventListener('click', () => {
                    setAuthMode(userState.authMode === 'login' ? 'register' : 'login');
                });
            }

            const authForm = document.getElementById('authForm');
            if (authForm) {
                authForm.addEventListener('submit', (event) => {
                    event.preventDefault();
                    submitAuthForm(new FormData(authForm));
                });
            }

            const displayNameInput = document.getElementById('authDisplayNameInput');
