        async function syncUserSession() {
            try {
                const response = await fetch('/api/auth/session');
                if (!response.ok) {
                    throw new Error(`Failed to fetch session: ${response.status}`);
                }

                const payload = await response.json();
                if (payload.authenticated) {
                    setAuthenticatedUser(payload.user);
                    return payload;
                }

                setAnonymousUser();
                return payload;
            } catch (error) {
                setAnonymousUser();
                console.error('Unable to load user session', error);
                return null;
            }
        }

        function renderSearchResults(query = '') {
            searchResultsPanel.innerHTML = '';

            if (!isSearchOpen) {
                searchResultsPanel.classList.add('hidden');
                return;
            }

            const trimmedQuery = query.trim();
            searchResultsPanel.classList.remove('hidden');

            if (!trimmedQuery) {
                renderRecentSearches();
                return;
            }

            if (!searchResults.length) {
                searchResultsPanel.innerHTML = `
                    <div class="rounded-md px-3 py-3 text-step--1 text-woodsmoke-500">
                        No matches found for "${escapeHtml(trimmedQuery)}".
                    </div>
                `;
                return;
            }

            searchResults.forEach((result) => {
                const item = document.createElement('button');
                item.type = 'button';
                item.setAttribute('role', 'option');
                item.className = 'flex w-full items-start justify-between rounded-md px-3 py-2 text-left transition hover:bg-iron-100';
                item.innerHTML = `
                    <span class="min-w-0">
                        <span class="block truncate text-step-0 font-medium text-woodsmoke-900">${escapeHtml(result.primaryLabel)}</span>
                        <span class="mt-0.5 block truncate text-step--1 text-woodsmoke-500">${escapeHtml(result.secondaryLabel)}</span>
                    </span>
                    <span class="ml-3 shrink-0 rounded-full bg-iron-100 px-2 py-1 text-[0.7rem] font-medium text-woodsmoke-600">
                        ${escapeHtml(result.badgeLabel)}
                    </span>
                `;
                item.addEventListener('click', () => {
                    setActiveMap(result.mapIndex);
                    closeSearchBar();
                });
                searchResultsPanel.appendChild(item);
            });
        }

        function renderRecentSearches() {
            searchResultsPanel.innerHTML = '';

            if (!recentSearches.length) {
                searchResultsPanel.classList.add('hidden');
                return;
            }

            const header = document.createElement('div');
            header.className = 'px-3 pb-2 pt-1 text-[0.7rem] font-semibold uppercase tracking-[0.08em] text-woodsmoke-400';
            header.textContent = 'Recent searches';
            searchResultsPanel.appendChild(header);

            recentSearches.forEach((recentQuery) => {
                const item = document.createElement('button');
                item.type = 'button';
                item.className = 'flex w-full items-center justify-between rounded-md px-3 py-2 text-left transition hover:bg-iron-100';
                item.innerHTML = `
                    <span class="truncate text-step--1 text-woodsmoke-700">${escapeHtml(recentQuery)}</span>
                    <span class="ml-3 shrink-0 text-woodsmoke-400">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M0 0h24v24H0z" fill="none" />
                            <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10a7 7 0 1 0 14 0a7 7 0 1 0-14 0m18 11l-6-6" />
                        </svg>
                    </span>
                `;
                item.addEventListener('click', () => {
                    topBarSearchInput.value = recentQuery;
                    updateSearchResults();
                    topBarSearchInput.focus();
                });
                searchResultsPanel.appendChild(item);
            });
        }

        function rememberRecentSearch(query) {
            const trimmedQuery = query.trim();
            if (!trimmedQuery) {
                return;
            }

            recentSearches = [
                trimmedQuery,
                ...recentSearches.filter((entry) => entry.toLowerCase() !== trimmedQuery.toLowerCase()),
            ].slice(0, 6);
        }

        function scoreMapAgainstQuery(map, mapIndex, query) {
            const normalizedQuery = query.trim().toLowerCase();
            if (!normalizedQuery) {
                return null;
            }

            const tokens = normalizedQuery.split(/\s+/).filter(Boolean);
            const searchableTileTypes = [...new Set((map.tiles || []).map((tile) => tile.type).filter(Boolean))];
            const fields = [
                { value: map.name || '', weight: 7, label: 'name' },
                { value: map.intent || '', weight: 5, label: 'intent' },
                { value: map.id || '', weight: 4, label: 'id' },
                { value: searchableTileTypes.join(' '), weight: 3, label: 'tiles' },
            ];

            let score = mapIndex === activeMapIndex ? 1.5 : 0;
            let matchedField = null;

            for (const token of tokens) {
                let tokenMatched = false;

                for (const field of fields) {
                    const normalizedField = field.value.toLowerCase();
                    if (!normalizedField) {
                        continue;
                    }

                    if (normalizedField === token) {
                        score += field.weight + 3;
                        tokenMatched = true;
                        matchedField = matchedField || field.label;
                        continue;
                    }

                    if (normalizedField.startsWith(token)) {
                        score += field.weight + 2;
                        tokenMatched = true;
                        matchedField = matchedField || field.label;
                        continue;
                    }

                    if (normalizedField.includes(token)) {
                        score += field.weight;
                        tokenMatched = true;
                        matchedField = matchedField || field.label;
                    }
                }

                if (!tokenMatched) {
                    return null;
                }
            }

            let primaryLabel = map.name;
            let secondaryLabel = map.intent;

            if (matchedField === 'tiles' && searchableTileTypes.length) {
                primaryLabel = map.name;
                secondaryLabel = `Tile types: ${searchableTileTypes.slice(0, 4).join(', ')}`;
            }

            return {
                mapIndex,
                score,
                primaryLabel,
                secondaryLabel,
                badgeLabel: mapIndex === activeMapIndex ? 'Current map' : map.name,
            };
        }

        function updateSearchResults() {
            const query = topBarSearchInput.value;
            if (!query.trim()) {
                searchResults = [];
                renderSearchResults(query);
                return;
            }

            searchResults = maps
                .map((map, mapIndex) => scoreMapAgainstQuery(map, mapIndex, query))
                .filter(Boolean)
                .sort((left, right) => right.score - left.score || left.mapIndex - right.mapIndex)
                .slice(0, 8);

            renderSearchResults(query);
        }

        function openSearchBar() {
            closeMapMenu();
            closeMapInfoPanel();
            closeUserProfilePanel();
            isSearchOpen = true;
            topBarDefault.classList.add('hidden');
            topBarSearch.classList.remove('hidden');
            topBarSearch.classList.add('flex');
            renderSearchResults(topBarSearchInput.value);
            window.requestAnimationFrame(() => {
                topBarSearchInput.focus();
                topBarSearchInput.select();
            });
        }

        function closeSearchBar() {
            isSearchOpen = false;
            topBarSearch.classList.add('hidden');
            topBarSearch.classList.remove('flex');
            topBarDefault.classList.remove('hidden');
            topBarSearchInput.value = '';
            searchResults = [];
            searchResultsPanel.classList.add('hidden');
        }

        function toggleSearchBar() {
            if (isSearchOpen) {
                closeSearchBar();
                return;
            }

            openSearchBar();
        }

        function submitSearchQuery() {
            const query = topBarSearchInput.value.trim();
            if (!query) {
                topBarSearchInput.focus();
                return;
            }

            rememberRecentSearch(query);
            updateSearchResults();
            if (searchResults.length) {
                setActiveMap(searchResults[0].mapIndex);
                closeSearchBar();
                return;
            }

            renderSearchResults(query);
        }

