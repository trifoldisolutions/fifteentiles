        function isSupportedClaimImage(file) {
            if (!file) {
                return false;
            }

            const validMimeTypes = ['image/png', 'image/jpeg'];
            if (validMimeTypes.includes(file.type)) {
                return true;
            }

            const lowerName = String(file.name || '').toLowerCase();
            return lowerName.endsWith('.png') || lowerName.endsWith('.jpg') || lowerName.endsWith('.jpeg');
        }

        function handleClaimImageFileSelection(file) {
            if (!file) {
                return;
            }

            const maxImageBytes = 5 * 1024 * 1024;
            if (!isSupportedClaimImage(file)) {
                showToast('Please select a PNG, JPG, or JPEG image.', {
                    tone: 'error',
                    durationMs: 6000,
                });
                claimSelectionImageInput.value = '';
                return;
            }

            if (file.size > maxImageBytes) {
                showToast('Image must be 5MB or smaller.', {
                    tone: 'error',
                    durationMs: 6000,
                });
                claimSelectionImageInput.value = '';
                return;
            }

            const reader = new FileReader();
            reader.onload = () => {
                applyClaimSelectionImageToContext(typeof reader.result === 'string' ? reader.result : '');
            };
            reader.onerror = () => {
                showToast('Unable to read that image file.', {
                    tone: 'error',
                    durationMs: 6000,
                });
            };
            reader.readAsDataURL(file);
        }

