        claimSelectionShareButton.addEventListener('click', async (e) => {
            e.stopPropagation();

            if (!claimSelectionState.viewingClaimId) {
                showToast('Open a claimed range to share it.', {
                    tone: 'info',
                    durationMs: 4000,
                });
                return;
            }

            const viewedClaim = getClaimedRangeById(claimSelectionState.viewingClaimId);
            const shareUrl = buildClaimShareUrl(viewedClaim);
            if (!shareUrl) {
                showToast('Unable to build a share URL for this range.', {
                    tone: 'error',
                    durationMs: 5000,
                });
                return;
            }

            try {
                await navigator.clipboard.writeText(shareUrl);
                showToast('Share link copied to clipboard.', {
                    tone: 'success',
                    durationMs: 3500,
                });
            } catch (error) {
                const hiddenInput = document.createElement('textarea');
                hiddenInput.value = shareUrl;
                hiddenInput.setAttribute('readonly', 'readonly');
                hiddenInput.style.position = 'fixed';
                hiddenInput.style.opacity = '0';
                hiddenInput.style.pointerEvents = 'none';
                document.body.appendChild(hiddenInput);
                hiddenInput.focus();
                hiddenInput.select();
                const didCopy = document.execCommand('copy');
                document.body.removeChild(hiddenInput);

                if (didCopy) {
                    showToast('Share link copied to clipboard.', {
                        tone: 'success',
                        durationMs: 3500,
                    });
                    return;
                }

                showToast('Could not copy automatically. Your share URL is ready in this browser tab.', {
                    tone: 'error',
                    durationMs: 5000,
                });
                window.history.replaceState(null, '', shareUrl);
            }
        });
