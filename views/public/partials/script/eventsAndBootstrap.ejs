        canvas.addEventListener('wheel', (e) => {
            e.preventDefault();
            cancelCameraAnimation();

            const rect = canvas.getBoundingClientRect();
            const mouseX = (e.clientX - rect.left - canvas.width / 2) / camera.zoom;
            const mouseY = (e.clientY - rect.top - canvas.height / 2) / camera.zoom;

            const zoomFactor = e.deltaY > 0 ? 0.9 : 1.1;
            const newZoom = Math.max(config.minZoom, Math.min(config.maxZoom, camera.zoom * zoomFactor));

            camera.x -= mouseX * (newZoom / camera.zoom - 1);
            camera.y -= mouseY * (newZoom / camera.zoom - 1);
            camera.zoom = newZoom;

            scheduleRender();
        }, { passive: false });

        canvas.addEventListener('mousedown', (e) => {
            if (e.button !== 0) {
                return;
            }

            const clickedClaimedRange = getClaimedRangeAtTile(screenPointToTile(e.clientX, e.clientY));
            cancelCameraAnimation();
            mouse.isDown = true;
            mouse.mode = clickedClaimedRange && !(e.ctrlKey || e.shiftKey)
                ? 'claimed-range'
                : (e.ctrlKey || e.shiftKey) && userState.isLoggedIn ? 'select' : 'pan';
            mouse.startX = e.clientX;
            mouse.startY = e.clientY;
            mouse.lastX = camera.x;
            mouse.lastY = camera.y;
            mouse.claimedRangeId = clickedClaimedRange?.id || null;
            mouse.moved = false;

            if (mouse.mode === 'select') {
                const startTile = screenPointToTile(e.clientX, e.clientY);
                selectionState.draft = createSelectionDraft(startTile, e.shiftKey ? 'remove' : 'replace');
                scheduleRender();
            }
        });

        canvas.addEventListener('mousemove', (e) => {
            if (mouse.isDown) {
                return;
            }

            const hoveredClaimedRange = getClaimedRangeAtTile(screenPointToTile(e.clientX, e.clientY));
            hoveredClaimedRangeBadgeId = null;
            wrapper.style.cursor = hoveredClaimedRange ? 'pointer' : '';
            scheduleRender();
        });

        canvas.addEventListener('mouseleave', () => {
            hoveredClaimedRangeBadgeId = null;
            wrapper.style.cursor = '';
            scheduleRender();
        });

        document.addEventListener('mousemove', (e) => {
            if (mouse.isDown) {
                if (mouse.mode === 'select') {
                    if (selectionState.draft) {
                        selectionState.draft = extendSelectionDraft(selectionState.draft, screenPointToTile(e.clientX, e.clientY));
                        scheduleRender();
                    }
                    return;
                }

                if (mouse.mode === 'claimed-range') {
                    return;
                }

                const deltaX = (e.clientX - mouse.startX) / camera.zoom;
                const deltaY = (e.clientY - mouse.startY) / camera.zoom;
                if (Math.abs(deltaX) > 0.5 || Math.abs(deltaY) > 0.5) {
                    mouse.moved = true;
                }

                camera.x = mouse.lastX + deltaX;
                camera.y = mouse.lastY + deltaY;

                scheduleRender();
            }
        });

        document.addEventListener('mouseup', () => {
            if (mouse.mode === 'pan' && mouse.moved) {
                suppressNextDocumentClick = true;
            }

            if (mouse.mode === 'select') {
                commitSelectionKeys(getSelectionKeys());
                selectionState.draft = null;
                scheduleRender();
            }

            if (mouse.mode === 'claimed-range') {
                selectedClaimedRangeId = mouse.claimedRangeId;
                clearTileSelection();
                scheduleRender();
            }

            mouse.isDown = false;
            mouse.mode = null;
            mouse.claimedRangeId = null;
            mouse.moved = false;
        });

        canvas.addEventListener('dblclick', (e) => {
            const clickedClaimedRange = getClaimedRangeAtTile(screenPointToTile(e.clientX, e.clientY));
            if (!clickedClaimedRange) {
                return;
            }

            e.preventDefault();
            e.stopPropagation();
            selectedClaimedRangeId = clickedClaimedRange.id;
            closeMapMenu();
            closeSearchBar();
            closeUserProfilePanel();
            closeEvaluateSelectionModal();
            claimSelectionState.isOpen = true;
            claimSelectionState.viewingClaimId = clickedClaimedRange.id;
            claimSelectionState.modalPosition = null;
            selectionState.draft = null;
            selectionState.committedBounds = null;
            selectionState.committedKeys = new Set();
            scheduleRender();
        });

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                hideToast();
                clearTileSelection();
                closeMapMenu();
                closeSearchBar();
                closeUserProfilePanel();
                closeEvaluateSelectionModal();
                scheduleRender();
            }

            const panDistance = 50 / camera.zoom;

            switch (e.key) {
                case 'ArrowUp':
                    e.preventDefault();
                    camera.y -= panDistance;
                    break;
                case 'ArrowDown':
                    e.preventDefault();
                    camera.y += panDistance;
                    break;
                case 'ArrowLeft':
                    e.preventDefault();
                    camera.x -= panDistance;
                    break;
                case 'ArrowRight':
                    e.preventDefault();
                    camera.x += panDistance;
                    break;
                default:
                    return;
            }

            cancelCameraAnimation();
            scheduleRender();
        });

        window.addEventListener('resize', resizeCanvas);

        resizeCanvas();
        renderSelectionModeToggle();
        updateUserProfileButton();
        syncUserSession().then(() => {
            applyTopUpReturnState();
        }).finally(() => {
            loadMaps();
        });
